# Pico's settings and secrets, one KEY=VALUE per line, read like CloudPi's cloudpi.secrets. Copy to pico.secrets, keep it
# private (chmod 600, readable by user 10001) and never commit it. It is mounted as the pico_secrets Docker secret; set
# PICO_SECRETS_FILE to read it from elsewhere, such as the file a secret manager writes to /tmp.
# Never copy CloudPi's platform secrets in here (DB_PASSWORD, SECRET_KEY, HMAC_SECRET_KEY, CRYPTO_SECRET, REDIS_PASSWORD):
# Pico refuses to start when it sees one.
#
# The image's agent.yml and analyst.yml templates take every ${NAME} in them from the keys below.

# CloudPi's website, without a path. CloudPi's two APIs are reached at it plus PICO_BE_PATH and PICO_PIFLASK_PATH.
PICO_SITE_URL=https://<cloudpi host>
# Optional: CloudPi's standard nginx paths are the defaults.
# PICO_BE_PATH=/CPiN
# PICO_PIFLASK_PATH=/CPiP

CLOUDPI_CLIENT_ID=pico-app
# The value of PICO_CLIENT_SECRET in CloudPi's cloudpi.secrets.
PICO_CLIENT_SECRET=

PICO_REDIS_URL=redis://<cloudpi host>:6379
# The value of REDIS_PASSWORD in CloudPi's cloudpi.secrets, under this name.
PICO_REDIS_PASSWORD=

# The Slack app. Pico refuses to start while one of these is missing or not an id/token of the right kind.
# CloudPi workspace whose Pico this is (Admin Settings > Integrations, PICO_SLACK). Default 1.
PICO_WORKSPACE_ID=1
# Slack workspace (team) id, T..., and the report channel id, C...; the channel must be private, with the bot invited.
PICO_SLACK_TEAM_ID=
PICO_SLACK_CHANNEL_ID=
# App-level token (xapp-..., scope connections:write) and bot token (xoxb-...) of the Slack app.
PICO_SLACK_APP_TOKEN=
PICO_SLACK_BOT_TOKEN=

# The AI model behind "More details" and @pico questions (the digest never uses one). Leave PICO_LLM_MODEL empty to use
# Gemini with GEMINI_API_KEY; or set provider/model, e.g. deepseek/deepseek-v4-flash, openai/gpt-5.5,
# claude/claude-sonnet-4-6, and that provider's key: DEEPSEEK_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, ...
# Without any model, details use a fixed template and questions get a fixed sentence.
PICO_LLM_MODEL=
GEMINI_API_KEY=
