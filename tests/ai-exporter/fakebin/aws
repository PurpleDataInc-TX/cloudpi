#!/usr/bin/env bash
# A stand-in for the AWS CLI used by test_setup_ai_exporter.sh. It records every call in $FAKE_AWS_LOG and answers
# the few reads the installer makes from files under $FAKE_AWS_DIR. Nothing real is touched.
set -u
echo "aws $*" >> "$FAKE_AWS_LOG"
args="$*"
arg_after() { local want="$1"; shift; while [ $# -gt 0 ]; do [ "$1" = "$want" ] && { echo "${2:-}"; return; }; shift; done; }

case "$args" in
  "sts get-caller-identity"*"--query Account"*) echo "123456789012" ;;
  "sts get-caller-identity"*) echo "arn:aws:iam::123456789012:user/installer" ;;
  "configure get region"*) echo "us-east-1" ;;
  "s3api head-bucket"*) [ -f "$FAKE_AWS_DIR/bucket" ] || exit 254 ;;
  "s3api create-bucket"*) touch "$FAKE_AWS_DIR/bucket" ;;
  "s3api head-object"*) exit 254 ;;
  "s3api list-objects-v2"*) echo "ai-billing/_runs/20261122T060012Z-3f9a1c2e/openai-2026-11.json" ;;
  "s3 cp s3://"*" - "*|"s3 cp s3://"*" -") echo '{"status": "ok", "provider": "openai", "month": "2026-11"}' ;;
  "cloudformation deploy"*) touch "$FAKE_AWS_DIR/stack" ;;
  "cloudformation describe-stacks"*)
    [ -f "$FAKE_AWS_DIR/stack" ] || { echo "An error occurred (ValidationError): Stack does not exist" >&2; exit 254; }
    query="$(arg_after --query "$@")"
    case "$query" in
      *StackStatus*) echo "CREATE_COMPLETE" ;;
      *FunctionName*) echo "cloudpi-ai-exporter-exporter" ;;
      *AnthropicSecretArn*) [ -f "$FAKE_AWS_DIR/no-anthropic" ] && echo "None" || echo "arn:aws:secretsmanager:us-east-1:123456789012:secret:cloudpi-ai-exporter/anthropic-AbCdEf" ;;
      *OpenAISecretArn*) echo "arn:aws:secretsmanager:us-east-1:123456789012:secret:cloudpi-ai-exporter/openai-GhIjKl" ;;
      *OutputBucketName*) echo "cloudpi-ai-focus-123456789012-us-east-1" ;;
      *OutputPrefix*) echo "ai-billing" ;;
      *) echo "None" ;;
    esac ;;
  "secretsmanager put-secret-value"*)
    id="$(arg_after --secret-id "$@")"; src="$(arg_after --secret-string "$@")"
    cp "${src#file://}" "$FAKE_AWS_DIR/secret-${id##*/}" ;;
  "lambda invoke"*)
    out="${*: -1}"
    echo '{"run_id": "20261122T060012Z-3f9a1c2e", "dry_run": true, "tasks": [{"provider": "anthropic", "month": "2026-11", "reason": "current"}]}' > "$out"
    echo '{"StatusCode": 200}' ;;
  *) : ;;
esac
exit 0
